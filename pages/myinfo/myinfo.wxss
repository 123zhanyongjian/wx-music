/* 黑胶风格基础变量 */
.black-vinyl {
  --vinyl-black: #121212;
  --vinyl-darker: #1a1a1a;
  --accent-color: #9e2a2b;
  --text-primary: #fff;
  --text-secondary: #888;
  --border-color: rgba(255,255,255,0.1);
  --vinyl-texture: rgba(255,255,255,0.02);
}

/* 整体容器 */
.myinfo-root {
  min-height: 100vh;
  background-color: var(--vinyl-black);
  padding: 0;
  box-sizing: border-box;
  position: relative;
}

/* 背景黑胶纹理 */
.bg-texture {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-image: radial-gradient(circle at center, var(--vinyl-texture) 1px, transparent 1px);
  background-size: 30rpx 30rpx;
  z-index: 0;
  pointer-events: none;
}

/* 固定的用户信息区 */
.fixed-info {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  background: linear-gradient(to bottom, #1a1a1a 0%, var(--vinyl-black) 100%);
  padding: 60rpx 20rpx 40rpx;
  border-bottom: 1rpx solid var(--border-color);
  z-index: 10;
}

/* 用户信息区 */
.user-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 10rpx;
}

/* 黑胶头像 */
.avatar-container {
  position: relative;
  margin-bottom: 30rpx;
}
.avatar {
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  padding: 0;
  background: transparent;
  border: none;
}
.avatar-img {
  width: 130rpx;
  height: 130rpx;
  border-radius: 50%;
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  border: 4rpx solid #2d2d2d;
  object-fit: cover;
}
.avatar-ring {
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #222, #1a1a1a);
  box-shadow: 0 8rpx 20rpx rgba(0,0,0,0.4);
  position: relative;
  overflow: hidden;
}
.avatar-dot {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background-color: var(--vinyl-black);
  border: 2rpx solid #333;
  z-index: 1;
}
.avatar-container:hover .avatar-ring {
  animation: rotate 20s linear infinite;
}

/* 用户名 */
.username {
  font-size: 34rpx;
  color: var(--text-primary);
  text-align: center;
  padding: 12rpx 25rpx;
  background-color: var(--vinyl-darker);
  border: 1rpx solid var(--border-color);
  border-radius: 24rpx;
  width: auto;
  min-width: 200rpx;
  margin-bottom: 10rpx;
}

/* 可滚动的歌单列表区 */
.scrollable-playlist {
  position: fixed;
  top: 320rpx; /* 用户信息区高度 */
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1;
}

/* 歌单列表 */
.playlist {
  padding:159rpx 20rpx  180rpx 20rpx; /* 底部留出悬浮按钮空间 */
  position: relative;
  z-index: 1;
}

/* 歌单标题 */
.playlist-title {
  display: flex;
  align-items: center;
  gap: 15rpx;
  margin-bottom: 30rpx;
  padding: 0 10rpx;
}
.title-decor {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background-color: var(--accent-color);
}
.playlist-title text {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary);
}
.title-line {
  flex: 1;
  height: 1rpx;
  background: linear-gradient(to right, var(--border-color), transparent);
}

/* 歌单网格 */
.music-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 30rpx;
}

/* 歌单卡片 */
.musicItem {
  background-color: var(--vinyl-darker);
  border-radius: 18rpx;
  overflow: hidden;
  border: 1rpx solid var(--border-color);
  transition: all 0.3s;
  padding-bottom: 20rpx;
}
.musicItem:hover {
  transform: translateY(-5rpx);
  box-shadow: 0 8rpx 20rpx rgba(0,0,0,0.3);
}
.musicItem:active {
  transform: translateY(-2rpx);
}

/* 歌单封面 */
.cover-wrapper {
  padding: 25rpx 0;
  display: flex;
  justify-content: center;
  position: relative;
}
.cover {
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background-size: cover;
  background-position: center;
  border: 4rpx solid #2d2d2d;
  position: relative;
  z-index: 1;
}
.cover-ring {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 260rpx;
  height: 260rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #222, #1a1a1a);
  box-shadow: 0 6rpx 15rpx rgba(0,0,0,0.3);
  z-index: 0;
}
.cover-shine {
  position: absolute;
  top: 10%;
  right: 10%;
  width: 40%;
  height: 40%;
  border-radius: 50%;
  background: linear-gradient(to bottom right, rgba(255,255,255,0.1), transparent);
  z-index: 1;
  pointer-events: none;
}

/* 歌单信息 */
.musicMeta {
  padding: 10rpx 20rpx 0;
  text-align: left;
}
.title {
  font-size: 29rpx;
  color: var(--text-primary);
  font-weight: 500;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  padding: 0 5rpx;
}
.count {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: var(--text-secondary);
  padding: 0 5rpx;
}

/* 空状态 */
.nodata {
  position: absolute;
  top: 20rpx;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 50rpx 0;
}
.empty-vinyl {
  position: relative;
  margin-bottom: 40rpx;
}
.empty-vinyl image {
  width: 220rpx;
  height: 220rpx;
  tint-color: #444;
}
.empty-dot {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  background-color: var(--vinyl-black);
  border: 2rpx solid #333;
  z-index: 1;
}
.empty-text {
  font-size: 32rpx;
  color: var(--text-secondary);
}
.new-link {
  color: var(--accent-color);
  margin: 0 8rpx;
  font-weight: 500;
  position: relative;
}
.new-link::after {
  content: '';
  position: absolute;
  left: 0;
  bottom: -3rpx;
  width: 0;
  height: 1rpx;
  background-color: var(--accent-color);
  transition: width 0.3s;
}
.new-link:hover::after {
  width: 100%;
}

/* 底部固定悬浮的新建按钮 */
.newListBtn-fixed {
  position: fixed;
  bottom: 260rpx;
  right: 60rpx;
  width: 80rpx;
  height: 80rpx;
  background-color: var(--accent-color);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 20rpx rgba(158,42,43,0.3);
  z-index: 100;
  transition: all 0.2s;
}
.avatar-img {
  /* 其他样式不变 */
  z-index: 2; /* 确保高于外圈的z-index:1 */
}
.avatar-ring {
  /* 其他样式不变 */
  z-index: 1; /* 低于头像 */
}
.newListBtn-fixed:active {
  transform: scale(0.95);
  box-shadow: 0 4rpx 10rpx rgba(158,42,43,0.4);
}
.add-icon-big {
  width: 40rpx;
  height: 40rpx;
  tint-color: #fff;
}

/* 动画定义 */
@keyframes rotate {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}