.netease-song-item {
  display: flex;
  align-items: center;
  background: var(--white);
  border-radius: 16rpx;
  box-shadow: var(--card-shadow);
  margin-bottom: 18rpx;
  padding: 0 20rpx;
  transition: var(--transition);
  position: relative;
  overflow: hidden;
  width: 100%;
  box-sizing: border-box;
  min-height: 100rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.netease-song-item:active {
  box-shadow: 0 8rpx 32rpx rgba(194,12,12,0.18);
  background: #fff5f5;
}
.netease-song-item-alt {
  background: #f7f7f7;
}
.netease-song-cover {
  width: 72rpx;
  height: 72rpx;
  border-radius: 12rpx;
  margin-right: 18rpx;
  background: #eee;
  position: relative;
  overflow: hidden;
  flex-shrink: 0;
}
.netease-song-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
  align-items: flex-start;
}
.netease-song-title {
  font-size: 30rpx;
  color: var(--main-color);
  font-weight: 700;
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.netease-song-artist {
  font-size: 22rpx;
  color: #888;
  margin-top: 2rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.netease-song-play {
  background: none;
  border: none;
  box-shadow: none;
  width: 60rpx;
  height: 60rpx;
  padding: 0;
  margin-left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  position: absolute;
  right: 70rpx;
  top: 50%;
  bottom: auto;
  margin-top: 0;
  transform: translateY(-50%);
  z-index: 2;
  transition: background 0.15s;
}
.netease-song-play:active {
  background: rgba(194,12,12,0.08);
}
.netease-song-play-icon {
  width: 40rpx;
  height: 40rpx;
  display: block;
}
.more {
  position: absolute;
  right: 10rpx;
  top: 50%;
  bottom: auto;
  width: 60rpx;
  height: 60rpx;
  border-left: 1px solid #eee;
  margin-top: 0;
  transform: translateY(-50%);
}
.alubmsList {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(30,215,96,0.10);
  padding: 20rpx 32rpx;
  margin: 18rpx 24rpx;
  transition: box-shadow 0.2s;
  position: relative;
}
.alubmsList .album-info {
  flex: 1;
}
.alubmsList .action-btns {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-left: 16rpx;
  flex-shrink: 0;
}
.alubmsList:active {
  box-shadow: 0 2rpx 8rpx rgba(30,215,96,0.18);
}
.alubmsList image {
  height: 120rpx;
  width: 120rpx;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.08);
  flex-shrink: 0;
}
.album-info {
  display: flex;
  flex-direction: column;
  justify-content: center;
  margin-left: 32rpx;
  flex: 1;
  min-width: 0;
}
.album-info .title {
  font-size: 32rpx;
  font-weight: bold;
  color: #222;
  margin-bottom: 8rpx;
  max-width: 48vw;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.release-date {
  font-size: 24rpx;
  color: #7c7c7c;
  margin-top: 0;
  letter-spacing: 1rpx;
  max-width: 48vw;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.more-btn {
  width: 72rpx !important;
  height: 72rpx !important;
  margin-left: 0;
  border-left: none;
  top: auto;
  right: auto;
  transform: none;
  display: block;
}