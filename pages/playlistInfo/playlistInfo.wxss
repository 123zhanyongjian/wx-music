/* 基础变量 */
.black-vinyl-page {
  --vinyl-black: #121212;
  --vinyl-darker: #1a1a1a;
  --accent-color: #9e2a2b;
  --status-bar-height: constant(safe-area-inset-top);
  --status-bar-height: env(safe-area-inset-top);
  --bottom-safe: calc(50px + env(safe-area-inset-bottom));
}

.mains {
  background-color: var(--vinyl-black);
  min-height: 100vh;
  padding-top: var(--status-bar-height);
  padding-bottom: var(--bottom-safe);
  box-sizing: border-box;
}

.imgs {
  position: absolute;
  z-index: 0;
  width: 100%;
  height: calc(525rpx + var(--status-bar-height));
  background-size: cover;
  background-position: center;
  filter: blur(40px);
  opacity: 0.6;
}

.mores {
  position: absolute;
  right: 15rpx;
  z-index: 10;
  top: calc(15px + var(--status-bar-height));
  width: 60rpx;
  height: 60rpx;
  tint-color: #fff;
}

.ng {
  position: absolute;
  height: calc(400rpx + var(--status-bar-height));
  width: 100%;
  background: linear-gradient(to bottom, rgba(0,0,0,0.1), rgba(0,0,0,0.8));
  z-index: 1;
}

.headLog {
  position: absolute;
  z-index: 10;
  left: 50rpx;
  top: calc(50rpx + var(--status-bar-height));
}
.headLog>image {
  height: 260rpx;
  width: 260rpx; 
  border-radius: 15px;
  border: 4rpx solid rgba(255,255,255,0.1);
  box-shadow: 0 10rpx 30rpx rgba(0,0,0,0.5);
}

.singer {
  position: absolute;
  z-index: 10;
  left: 330rpx;
  top: calc(120rpx + var(--status-bar-height));
  color: rgba(255,255,255,0.9);
  font-size: 36rpx;
  font-weight: 600;
}

.scroll-view {
  position: absolute;
  z-index: 2;
  width: 100%;
  top: calc(390rpx + var(--status-bar-height));
  background-color: var(--vinyl-black);
  padding-bottom: var(--bottom-safe);
}

/* 播放全部栏（核心修复） */
.play-all-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background-color: var(--vinyl-darker);
  border-top-left-radius: 16px;
  border-top-right-radius: 16px;
  padding: 20rpx 30rpx;
  border-bottom: 1rpx solid rgba(255,255,255,0.05);
  margin-bottom: 10rpx;
}
.play-all-btn {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.play-icon {
  width: 60rpx;
  height: 60rpx;
  tint-color: var(--accent-color);
  flex-shrink: 0;
}
.play-text {
  color: #ddd;
  font-size: 30rpx;
  white-space: nowrap;
}
.loop-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 60rpx;
  height: 60rpx;
  flex-shrink: 0;
}
.loop-icon {
  width: 40rpx;
  height: 40rpx;
  tint-color: #888;
}

/* 歌曲列表样式 */
.netease-song-item {
  background-color: var(--vinyl-darker);
  border-bottom: 1rpx solid rgba(255,255,255,0.05);
}
.netease-song-title {
  color: #fff;
}
.netease-song-artist {
  color: #888;
}
.netease-song-play-icon {
  tint-color: var(--accent-color);
}
.netease-song-item:active {
  background-color: rgba(158,42,43,0.1);
}

.popusShowopen {
  height: calc(100vh - 525rpx - var(--status-bar-height) - var(--bottom-safe));
  z-index: 1 !important; /* 弹窗打开时降低层级，确保在弹窗下方 */
  position: relative; /* 确保 z-index 生效 */
}