/* 黑胶主题变量 */
.black-vinyl {
  --bg-color: #121212;
  --card-color: #1a1a1a;
  --text-primary: #fff;
  --text-secondary: #888;
  --accent-color: #9e2a2b;
  --border-color: rgba(255, 255, 255, 0.1);
  --text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.3);
}

/* 关键修改：添加全局背景色 */
.search-root {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: var(--bg-color);
  overflow: hidden;
}

/* 背景纹理 */
.bg-texture {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-image: radial-gradient(circle at center, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
  background-size: 30rpx 30rpx;
  z-index: 0;
  pointer-events: none;
}

/* 搜索头部 */
.search-header {
  position: fixed;
  top: 120rpx;
  left: 0;
  right: 0;
  height: 120rpx;
  padding: 20rpx 30rpx;
  box-sizing: border-box;
  background: linear-gradient(to bottom, rgba(18, 18, 18, 0.9), rgba(18, 18, 18, 0.7));
  backdrop-filter: blur(10rpx);
  z-index: 10;
  display: flex;
  align-items: center;
}

.back-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: none;
  border: none;
  padding: 0;
  margin-right: 20rpx;
}

.back-icon {
  width: 30rpx;
  height: 30rpx;
  tint-color: #fff;
}

.search-box {
  flex: 1;
  height: 80rpx;
  background-color: var(--card-color);
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  padding: 0 30rpx;
  position: relative;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.2);
}

.search-icon {
  width: 36rpx;
  height: 36rpx;
  tint-color: var(--text-secondary);
  margin-right: 15rpx;
}

.search-input {
  flex: 1;
  height: 100%;
  font-size: 28rpx;
  color: var(--text-primary);
  background: none;
}

.clear-btn {
  width: 40rpx;
  height: 40rpx;
  background: none;
  border: none;
  padding: 0;
  margin-left: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.clear-icon {
  width: 28rpx;
  height: 28rpx;
  tint-color: var(--text-secondary);
}

/* 搜索结果区域 */
.search-result {
  position: fixed;
  top: 240rpx;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 30rpx 160rpx 30rpx;
  box-sizing: border-box;
  overflow-y: auto;
  z-index: 1;
}

/* 搜索历史区域 */
.search-history-section {
  margin-bottom: 40rpx;
}

.history-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.history-title {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.clear-history-btn {
  font-size: 24rpx;
  color: var(--text-secondary);
  padding: 5rpx 15rpx;
}

.clear-history-btn:active {
  color: var(--accent-color);
}

.history-list {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
  margin-bottom: 30rpx;
}

.history-item {
  display: flex;
  align-items: center;
  padding: 10rpx 20rpx;
  background-color: var(--card-color);
  border-radius: 25rpx;
  gap: 10rpx;
}

.history-keyword {
  font-size: 26rpx;
  color: var(--text-primary);
}

.delete-icon {
  width: 24rpx;
  height: 24rpx;
  tint-color: var(--text-secondary);
  opacity: 0.6;
}

.delete-icon:active {
  opacity: 1;
  tint-color: var(--accent-color);
}

/* 热门搜索区域 */
.hot-search-section {
  margin-top: 30rpx;
}

.hot-title {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
  margin-bottom: 20rpx;
  display: block;
}

.hot-words {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
}

.hot-word {
  padding: 10rpx 25rpx;
  background-color: var(--card-color);
  border-radius: 25rpx;
  font-size: 26rpx;
  color: var(--text-primary);
  transition: all 0.2s;
}

.hot-word:active {
  background-color: var(--accent-color);
  transform: scale(0.95);
}

/* 加载状态 */
.loading-section {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 80rpx 0;
}

.loading-text {
  font-size: 28rpx;
  color: var(--text-secondary);
}

/* 通用区块样式 */
.section {
  margin-bottom: 40rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: 25rpx;
  text-shadow: var(--text-shadow);
  display: flex;
  align-items: center;
}

.section-title::before {
  content: '';
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background-color: var(--accent-color);
  margin-right: 15rpx;
}

/* 歌手列表 */
.singer-list {
  display: flex;
  flex-wrap: wrap;
  gap: 30rpx 20rpx;
}

.singer-card {
  width: 160rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.singer-avatar {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 15rpx;
}

.avatar-img {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  object-fit: cover;
  border: 3rpx solid #2d2d2d;
  z-index: 2;
}

.avatar-ring {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #222, #1a1a1a);
  box-shadow: 0 5rpx 15rpx rgba(0, 0, 0, 0.3);
  position: absolute;
  top: 0;
  left: 0;
  z-index: 1;
}

.singer-name {
  font-size: 26rpx;
  color: var(--text-primary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  width: 100%;
  text-align: center;
}

/* 歌曲列表 */
.song-list {
  background-color: var(--card-color);
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.3);
}

.song-item {
  display: flex;
  align-items: center;
  height: 120rpx;
  padding: 0 25rpx;
  border-bottom: 1rpx solid var(--border-color);
  position: relative;
  transition: all 0.2s;
}

.song-item:active {
  background-color: rgba(158, 42, 43, 0.1);
}

.song-index {
  width: 40rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  text-align: center;
  margin-right: 15rpx;
}

.song-vinyl {
  position: relative;
  width: 80rpx;
  height: 80rpx;
  margin-right: 20rpx;
}

.song-img {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  object-fit: cover;
  border: 3rpx solid #333;
  z-index: 2;
}

.song-vinyl-ring {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #222, #1a1a1a);
  box-shadow: 0 3rpx 8rpx rgba(0, 0, 0, 0.3);
  z-index: 1;
}

.song-info {
  flex: 1;
  min-width: 0;
  margin-right: 20rpx;
}

.song-title {
  display: block;
  font-size: 28rpx;
  color: var(--text-primary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.song-artist {
  display: block;
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 5rpx;
}

.mv-tag {
  padding: 5rpx 15rpx;
  border: 1rpx solid #4a90e2;
  color: #4a90e2;
  border-radius: 15rpx;
  font-size: 22rpx;
  margin-right: 15rpx;
}

.play-btn {
  width: 50rpx;
  height: 50rpx;
  background: none;
  border: none;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.play-icon {
  width: 30rpx;
  height: 30rpx;
  tint-color: var(--text-secondary);
}

/* 无结果提示 */
.empty-result {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
}

.empty-img {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
  tint-color: var(--text-secondary);
}

.empty-text {
  font-size: 32rpx;
  color: var(--text-secondary);
  margin-bottom: 15rpx;
}
.tab-content{
  padding-top: 60rpx !important;
}
.empty-suggest {
  font-size: 26rpx;
  color: var(--text-secondary);
  opacity: 0.7;
}