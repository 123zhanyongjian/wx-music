<view class="search-root black-vinyl tab-content">
  <!-- 背景纹理 -->
  <view class="bg-texture"></view>

  <!-- 搜索框区域 -->
  <view class="search-header">
    <!-- 返回按钮 -->
    <button class="back-btn" bindtap="goBack">
      <image src="../../image/back.svg" class="back-icon"></image>
    </button>
    
    <!-- 简化的搜索框 -->
    <view class="search-box">
      <image class="search-icon" src="../../image/search.svg"></image>
      <input 
        confirm-type="search" 
        type="text" 
        class="search-input" 
        placeholder="搜索歌曲、歌手" 
        value="{{serach}}" 
        bindinput="onSearchInput" 
        bindconfirm="getData"
      />
      <button class="clear-btn" wx:if="{{serach}}" catchtap="clearSearch">
        <image src="../../image/clear.svg" class="clear-icon"></image>
      </button>
    </view>
  </view>

  <!-- 搜索结果区域 -->
  <scroll-view class="search-result" scroll-y="true">
    <!-- 搜索历史（无关键词时显示） -->
    <view class="search-history-section" wx:if="{{showHistory && !serach}}">
      <!-- 搜索历史标题 -->
      <view class="history-header" wx:if="{{searchHistory.length > 0}}">
        <text class="history-title">搜索历史</text>
        <text class="clear-history-btn" catchtap="clearSearchHistory">清空</text>
      </view>
      
      <!-- 搜索历史列表 -->
      <view class="history-list" wx:if="{{searchHistory.length > 0}}">
        <view 
          class="history-item" 
          wx:for="{{searchHistory}}" 
          wx:key="*this"
          wx:for-item="keyword"
        >
          <text class="history-keyword" catchtap="fillSearch" data-word="{{keyword}}">{{keyword}}</text>
          <image 
            class="delete-icon" 
            src="../../image/close.svg" 
            catchtap="deleteHistoryItem" 
            data-word="{{keyword}}"
          />
        </view>
      </view>
      
      <!-- 热门搜索 -->
      <view class="hot-search-section">
        <text class="hot-title">热门搜索</text>
        <view class="hot-words">
          <text 
            class="hot-word" 
            wx:for="{{hotKeywords}}" 
            wx:key="*this"
            wx:for-item="keyword"
            catchtap="fillSearch" 
            data-word="{{keyword}}"
          >{{keyword}}</text>
        </view>
      </view>
    </view>

    <!-- 歌手列表 -->
    <view class="section" wx:if="{{singerList.length > 0}}">
      <view class="section-title">热门歌手</view>
      <view class="singer-list">
        <block wx:for="{{singerList}}" wx:key="id" wx:for-item="singer">
          <view class="singer-card" data-singer="{{singer}}" bindtap="goToSingerDetail">
            <view class="singer-avatar">
              <image src="{{singer.pic || '../../image/default-avatar.png'}}" class="avatar-img" />
              <view class="avatar-ring"></view>
            </view>
            <text class="singer-name">{{singer.name}}</text>
          </view>
        </block>
      </view>
    </view>

    <!-- 歌曲列表 -->
    <view class="section" wx:if="{{song.length > 0}}">
      <view class="section-title">搜索结果</view>
      <view class="song-list">
        <block wx:for="{{song}}" wx:key="id" wx:for-item="song">
          <view class="song-item" data-song="{{song}}">
            <view class="song-index">{{index + 1}}</view>
            <view class="song-vinyl" catchtap="pay" data-song="{{song}}">
              <image src="{{song.pic||song.image || '../../image/default-cover.png'}}" class="song-img" mode="aspectFill" lazy-load="{{true}}" />
              <view class="song-vinyl-ring"></view>
            </view>
            <view class="song-info" catchtap="pay" data-song="{{song}}">
              <text class="song-title">{{song.title}}</text>
              <text class="song-artist">{{song.author}}</text>
            </view>
            <text class="mv-tag" wx:if="{{song.mvid || song.vid}}">MV</text>
            <button class="play-btn" catchtap="pay" data-song="{{song}}" hover-class="play-btn-hover">
              <image src="../../image/play.svg" class="play-icon" />
            </button>
          </view>
        </block>
      </view>
    </view>

    <!-- 加载状态 -->
    <view class="loading-section" wx:if="{{loading}}">
      <text class="loading-text">搜索中...</text>
    </view>

    <!-- 无结果提示 -->
    <view class="empty-result" wx:if="{{serach && !loading && song.length === 0 && singerList.length === 0}}">
      <image src="../../image/nodata.svg" class="empty-img" />
      <text class="empty-text">暂无搜索结果</text>
      <text class="empty-suggest">请尝试其他关键词</text>
    </view>
  </scroll-view>
</view>