<!-- pages/newPlay/newPlay.wxml -->
<wxs src="../singerdetails/singerdetails.wxs" module="module"></wxs>

<view class="netease-pro-play-root">
  <!-- 顶部毛玻璃背景 -->
  <view class="netease-pro-bg-blur">
    <image class="netease-pro-bg-img" src="{{img}}" mode="aspectFill" />
    <view class="netease-pro-bg-mask"></view>
  </view>

  <!-- 黑胶盘区 -->
  <view class="netease-pro-disc-area">
    <view class="netease-pro-disc3d {{!state ? 'rotating' : ''}}">
      <svg class="netease-pro-disc3d-svg" width="360" height="360" viewBox="0 0 360 360">
        <defs>
          <radialGradient id="vinylPro" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color="#888"/>
            <stop offset="60%" stop-color="#222"/>
            <stop offset="100%" stop-color="#111"/>
          </radialGradient>
          <radialGradient id="shinePro" cx="40%" cy="40%" r="60%">
            <stop offset="0%" stop-color="#fff" stop-opacity="0.22"/>
            <stop offset="100%" stop-color="#fff" stop-opacity="0"/>
          </radialGradient>
        </defs>
        <circle cx="180" cy="180" r="170" fill="url(#vinylPro)" stroke="#e93b3d" stroke-width="16"/>
        <circle cx="180" cy="180" r="150" fill="none" stroke="#222" stroke-width="10"/>
        <circle cx="180" cy="180" r="130" fill="none" stroke="#333" stroke-width="6"/>
        <circle cx="180" cy="180" r="60" fill="#333" />
        <circle cx="180" cy="180" r="16" fill="#fff" />
        <ellipse cx="120" cy="120" rx="48" ry="16" fill="url(#shinePro)"/>
      </svg>
      <image class="netease-pro-cover3d" src="{{img}}" mode="aspectFill" />
    </view>
    <view class="netease-pro-artist">{{author}}</view>
  </view>

  <!-- 歌词区 -->
  <view class="netease-pro-lyric-area" bindtap="onLyricTap">
    <block wx:if="{{!showFullLyric}}">
      <view class="netease-pro-lyric-single">
        {{ (lrc && lrc.length > 0 && lrc[toLineNum] && lrc[toLineNum].lrc) ? lrc[toLineNum].lrc : '' }}
      </view>
    </block>
    <block wx:else>
      <scroll-view class="netease-pro-lyric-list" scroll-y="true">
        <view wx:for="{{lrc}}" wx:key="index" class="netease-pro-lyric-line {{toLineNum===index?'active':''}}">{{item.lrc}}</view>
      </scroll-view>
    </block>
  </view>

  <!-- 进度条 -->
  <view class="netease-pro-progress">
    <text>{{conduct}}</text>
    <slider class="netease-pro-slider" min="0" max="{{max}}" step="1" value="{{value}}" activeColor="#e93b3d" backgroundColor="#fff" block-size="18" block-color="#e93b3d" bindchange="changeslider" />
    <text>{{Duration}}</text>
  </view>

  <!-- 底部控制区 -->
  <view class="netease-pro-controls">
    <view class="netease-pro-btn" bindtap="changloop">
      <svg width="54" height="54" viewBox="0 0 48 48"><path d="M8 24a16 16 0 1 1 16 16" stroke="#fff" stroke-width="3" fill="none"/><polyline points="32,40 40,40 40,32" stroke="#fff" stroke-width="3" fill="none"/></svg>
    </view>
    <view class="netease-pro-btn" bindtap="last">
      <svg width="54" height="54" viewBox="0 0 48 48"><polygon points="32,12 16,24 32,36" fill="#fff"/><rect x="12" y="12" width="4" height="24" fill="#fff"/></svg>
    </view>
    <view class="netease-pro-btn-main" bindtap="pays">
      <svg wx:if="!state" width="100" height="100" viewBox="0 0 100 100"><circle cx="50" cy="50" r="48" fill="#e93b3d"/><polygon points="40,30 76,50 40,70" fill="#fff"/></svg>
      <svg wx:elif="state" width="100" height="100" viewBox="0 0 100 100"><circle cx="50" cy="50" r="48" fill="#e93b3d"/><rect x="36" y="30" width="10" height="40" fill="#fff"/><rect x="54" y="30" width="10" height="40" fill="#fff"/></svg>
    </view>
    <view class="netease-pro-btn" bindtap="next">
      <svg width="54" height="54" viewBox="0 0 48 48"><polygon points="16,12 32,24 16,36" fill="#fff"/><rect x="32" y="12" width="4" height="24" fill="#fff"/></svg>
    </view>
    <view class="netease-pro-btn" bindtap="open">
      <svg width="54" height="54" viewBox="0 0 48 48"><rect x="8" y="12" width="32" height="4" rx="2" fill="#fff"/><rect x="8" y="22" width="32" height="4" rx="2" fill="#fff"/><rect x="8" y="32" width="32" height="4" rx="2" fill="#fff"/></svg>
    </view>
  </view>
</view>

<view wx:if="{{Mv}}">
<video id="myMv" 	initial-time="{{value}}" show="{{Mv}}" src="{{Mvsrc}}"  binderror="bindMvError"></video>
<text wx:if="{{Mv}}" class="cuo" bindtap="cuos">×</text>
</view>

<popup song="{{song}}"  bind:close="popusShowChange" show="{{popusShow}}"  wx:if="{{popusShow}}" header="添加到歌单" >
</popup>