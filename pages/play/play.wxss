/* 全新网易云风格播放器 */
.netease-pro-play-root {
  min-height: 100vh;
  background: #18171c;
  position: relative;
  padding-bottom: 120rpx;
  box-sizing: border-box;
  overflow: hidden;
}
.netease-pro-bg-blur {
  position: absolute;
  left: 0; right: 0; top: 0; bottom: 0;
  z-index: 0;
  overflow: hidden;
}
.netease-pro-bg-img {
  width: 100vw;
  height: 100vh;
  filter: blur(48px) brightness(0.4);
}
.netease-pro-bg-mask {
  position: absolute;
  left: 0; right: 0; top: 0; bottom: 0;
  background: linear-gradient(to bottom, rgba(24,23,28,0.92) 60%, #18171c 100%);
  z-index: 1;
}
.netease-pro-disc-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 60rpx;
  z-index: 2;
}
.netease-pro-disc3d {
  position: relative;
  width: 360rpx;
  height: 360rpx;
  margin-bottom: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 32rpx 80rpx rgba(0,0,0,0.45);
  background: transparent;
}
.netease-pro-disc3d-svg {
  position: absolute;
  left: 0; top: 0;
  width: 360rpx;
  height: 360rpx;
  z-index: 1;
  filter: drop-shadow(0 16rpx 40rpx #000a);
}
.netease-pro-cover3d {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  transform: translate(-50%, -50%);
  box-shadow: 0 12rpx 40rpx rgba(233,59,61,0.38);
  border: 18rpx solid #fff;
  z-index: 2;
}
.rotating {
  animation: rotate-disc 12s linear infinite;
}
@keyframes rotate-disc {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}
.netease-pro-artist {
  color: #e0e0e0;
  font-size: 28rpx;
  text-align: center;
  margin-top: 12rpx;
  margin-bottom: 12rpx;
  max-width: 80vw;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.netease-pro-lyric-area {
  position: relative;
  z-index: 2;
  margin: 40rpx auto 0 auto;
  width: 90vw;
  max-width: 700rpx;
  min-height: 80rpx;
  height: 220rpx;
  background: rgba(40,40,50,0.7);
  border-radius: 36rpx;
  box-shadow: 0 4rpx 24rpx rgba(233,59,61,0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 20rpx;
  overflow: hidden;
  backdrop-filter: blur(12px);
}
.netease-pro-lyric-single {
  font-size: 40rpx;
  color: #fff;
  font-weight: bold;
  text-align: center;
  width: 100%;
  line-height: 90rpx;
  letter-spacing: 2rpx;
  text-shadow: 0 2rpx 8rpx #e93b3d88, 0 0 2rpx #fff;
  white-space: pre-line;
}
.netease-pro-lyric-list {
  width: 100%;
  height: 220rpx;
  overflow-y: scroll;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: transparent;
}
.netease-pro-lyric-line {
  font-size: 28rpx;
  color: #bbb;
  line-height: 48rpx;
  text-align: center;
  transition: color 0.2s;
}
.netease-pro-lyric-line.active {
  color: #e93b3d;
  font-weight: bold;
  font-size: 34rpx;
  text-shadow: 0 2rpx 8rpx #e93b3d88, 0 0 2rpx #fff;
}
.netease-pro-progress {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 90vw;
  max-width: 700rpx;
  margin: 24rpx auto 0 auto;
  z-index: 2;
}
.netease-pro-slider {
  flex: 1;
  margin: 0 20rpx;
}
.netease-pro-controls {
  position: fixed;
  left: 0; right: 0; bottom: 120rpx;
  z-index: 10;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 40rpx;
  background: rgba(24,23,28,0.98);
  border-radius: 48rpx 48rpx 0 0;
  box-shadow: 0 -4rpx 24rpx rgba(233,59,61,0.12);
  padding: 32rpx 0 16rpx 0;
}
.netease-pro-btn {
  width: 72rpx;
  height: 72rpx;
  opacity: 0.92;
  display: flex;
  align-items: center;
  justify-content: center;
}
.netease-pro-btn-main {
  width: 130rpx;
  height: 130rpx;
  background: linear-gradient(135deg, #e93b3d 60%, #fff 100%);
  border-radius: 50%;
  box-shadow: 0 8rpx 32rpx rgba(233,59,61,0.22);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 20rpx;
  border: 8rpx solid #fff;
  opacity: 1;
}
.netease-pro-btn-main svg {
  width: 100rpx;
  height: 100rpx;
}