/* singerdetails.wxss */
/* 黑胶风格基础变量 */
.black-vinyl-page {
  --vinyl-black: #121212;
  --vinyl-darker: #1a1a1a;
  --accent-color: #9e2a2b;
  --text-primary: #fff;
  --text-secondary: #888;
  --border-color: rgba(255,255,255,0.05);
  --status-bar-height: constant(safe-area-inset-top);
  --status-bar-height: env(safe-area-inset-top);
  --bottom-safe: calc(50px + env(safe-area-inset-bottom));
  background-color: var(--vinyl-black);
  min-height: 100vh;
  padding-bottom: var(--bottom-safe);
}

/* 顶部背景 */
.imgs {
  position: absolute;
  z-index: 0;
  width: 100%;
  height: calc(525rpx + var(--status-bar-height));
  background-size: cover;
  background-position: center;
  filter: blur(40px);
  opacity: 0.6;
}

/* 半透明遮罩 */
.ng {
  position: absolute;
  height: calc(525rpx + var(--status-bar-height));
  width: 100%;
  background: linear-gradient(to bottom, rgba(0,0,0,0.2), rgba(0,0,0,0.9));
  z-index: 1;
}

/* 左侧封面 */
.headLog {
  position: absolute;
  z-index: 10;
  left: 50rpx;
  top: calc(50rpx + var(--status-bar-height));
}
.headLog>image {
  height: 260rpx;
  width: 260rpx; 
  border-radius: 15px;
  border: 4rpx solid rgba(255,255,255,0.1);
  box-shadow: 0 8rpx 20rpx rgba(0,0,0,0.5);
}

/* 右侧信息区 */
.singer {
  position: absolute;
  z-index: 10;
  left: 330rpx;
  top: calc(50rpx + var(--status-bar-height));
  color: rgba(255,255,255,0.8);
  max-width: 450rpx;
}
.singer>view:first-child {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.text {
  padding: 10rpx 0;
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.4;
}

/* 单曲/专辑切换栏 */
.musicAndAlbums {
  display: flex;
  position: absolute;
  bottom: 0;
  left: 0;
  height: 140rpx;
  right: 0;
  color: var(--text-secondary);
  z-index: 10;
  justify-content: space-around;
  background-color: rgba(0,0,0,0.7);
  align-items: center;
}
.musicAndAlbums image {
  width: 50rpx;
  height: 50rpx;
  vertical-align: middle;
  tint-color: var(--text-secondary);
}
.musicAndAlbums text {
  margin-left: 15rpx;
  font-size: 28rpx;
}
.music.active, .albums.active {
  color: var(--accent-color);
}
.music.active image, .albums.active image {
  tint-color: var(--accent-color);
}

/* 播放全部栏 */
.play-all-bar {
  background-color: var(--vinyl-darker);
  border-top-left-radius: 16px;
  border-top-right-radius: 16px;
  padding: 20rpx 50rpx;
  border-bottom: 1rpx solid var(--border-color);
}
.play-icon {
  width: 60rpx;
  height: 60rpx;
  tint-color: var(--accent-color);
  vertical-align: middle;
}
.play-text {
  color: var(--text-primary);
  font-size: 30rpx;
  margin-left: 10rpx;
  vertical-align: middle;
}
.loop-container {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.loop {
  width: 40rpx;
  height: 40rpx;
  tint-color: var(--text-secondary);
}

/* 滚动区样式 */
.scroll-view {
  position: absolute;
  z-index: 2;
  width: 100%;
  top: calc(490rpx + var(--status-bar-height));
  background-color: var(--vinyl-black);
  padding-bottom: var(--bottom-safe);
}
.ul {
  width: 100%;
  border-radius: 16px;
  padding: 0 24rpx;
  box-sizing: border-box;
}

/* 单曲列表项 */
.netease-song-item {
  background-color: var(--vinyl-darker);
  border-bottom: 1rpx solid var(--border-color);
  margin-bottom: 12rpx;
}
.netease-song-title {
  color: var(--text-primary);
  max-width: calc(100% - 180rpx);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.netease-song-artist {
  color: var(--text-secondary);
}
.netease-song-play-icon {
  tint-color: var(--accent-color);
}
.netease-song-item:active {
  background-color: rgba(158,42,43,0.1);
}
.more {
  border-left: 1rpx solid var(--border-color);
  tint-color: var(--text-secondary);
}

/* 专辑列表标题区 */
.album-list-header {
  padding: 25rpx 24rpx;
}
.header-text {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  position: relative;
  padding-left: 15rpx;
}
.header-text::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 24rpx;
  background-color: var(--accent-color);
  border-radius: 3rpx;
}
.header-line {
  height: 1rpx;
  background-color: var(--border-color);
  margin-top: 15rpx;
}

/* 专辑封面（黑胶唱片样式） */
.album-vinyl {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  flex-shrink: 0;
}
.album-cover {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 90rpx;
  height: 90rpx;
  border-radius: 50%;
  object-fit: cover;
  border: 3rpx solid #2d2d2d;
  z-index: 1;
}
.vinyl-ring {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #222, #1a1a1a);
  box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.4);
}
.vinyl-dot {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background-color: #121212;
  border: 2rpx solid #333;
  z-index: 2;
}

/* 专辑信息区 */
.album-info {
  display: flex;
  flex-direction: column;
  justify-content: center;
  margin-left: 25rpx;
  flex: 1;
  min-width: 0;
}
.album-info .title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.release-date {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-bottom: 5rpx;
}
.song-count {
  font-size: 22rpx;
  color: var(--text-secondary);
}

/* 专辑列表项 */
.alubmsList {
  display: flex;
  align-items: center;
  background-color: var(--vinyl-darker);
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.3);
  padding: 20rpx 25rpx;
  margin: 15rpx 24rpx;
  transition: all 0.2s ease;
}
.alubmsList:active {
  transform: translateY(2rpx);
  box-shadow: 0 2rpx 8rpx rgba(158,42,43,0.2);
  background-color: rgba(26,26,26,0.8);
}

/* 空状态样式 */
.empty-state {
  text-align: center;
  padding-top: 150rpx;
}
.empty-img {
  width: 150rpx;
  height: 150rpx;
  tint-color: #444;
  margin-bottom: 30rpx;
}
.empty-text {
  font-size: 28rpx;
  color: var(--text-secondary);
}

/* 切换动画适配 */
.active1, .active2 {
  background-color: var(--vinyl-black);
}
.popusShowopen {
  height: calc(100vh - 525rpx - var(--status-bar-height));
  overflow: hidden;
}