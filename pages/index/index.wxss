/* 基础容器样式（禁止整体滚动） */
.page {
  background-color: #121212;
  min-height: 97vh;
  padding: 0 30rpx;
  padding-top: 60rpx;
  box-sizing: border-box;
  color: #fff;
  overflow: hidden; /* 关键：禁止页面整体滚动 */
}
/* 歌曲封面图片（提高层级） */
.song-img {
  /* 原有样式不变 */
  z-index: 2; /* 高于外圈的z-index:1 */
}

/* 黑胶外圈（降低层级） */
.song-vinyl-ring {
  /* 原有样式不变 */
  z-index: 1; /* 确保低于封面 */
}
/* 顶部渐变背景（模拟唱片反光） */
.top-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 320rpx;
  background: linear-gradient(135deg, rgba(102, 26, 26, 0.15), transparent 60%);
  z-index: 0;
}

/* 头部标题 */
.header {
  position: relative;
  padding: 40rpx 0 20rpx;
  z-index: 1;
}
.header-title {
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}
.header-decor {
  width: 60rpx;
  height: 6rpx;
  background-color: #9e2a2b; /* 酒红色强调色 */
  border-radius: 3rpx;
  margin-top: 15rpx;
}

/* 功能导航（黑胶按钮） */
.func-nav {
  display: flex;
  justify-content: space-around;
  margin: 20rpx 0 50rpx;
  gap: 10rpx;
  position: relative;
  z-index: 1;
}
.func-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 140rpx;
}

/* 功能按钮黑胶样式 */
.func-vinyl {
  position: relative;
  width: 100rpx;
  height: 100rpx;
  margin-bottom: 15rpx;
}
.vinyl-ring {
  position: absolute;
  top: 0;
  left: 0;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #222, #1a1a1a);
  box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.4);
}
.vinyl-dot {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background-color: #121212;
  border: 2rpx solid #333;
  z-index: 2;
}
.func-icon {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 40rpx;
  height: 40rpx;
  z-index: 1;
  tint-color: #9e2a2b;
}
.func-text {
  font-size: 26rpx;
  color: #ddd;
  margin-top: 10rpx;
}

/* 通用区块样式 */
.section {
  margin-bottom: 50rpx;
  position: relative;
  z-index: 1;
}
.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 25rpx;
}
.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
}
.section-line {
  flex: 1;
  height: 1rpx;
  background-color: rgba(255,255,255,0.1);
  margin-left: 15rpx;
}

/* 推荐歌单区（仅左右滑动） */
.playlist-scroll {
  white-space: nowrap;
  padding-bottom: 10rpx;
  overflow-y: hidden; /* 禁止纵向滚动 */
}
.playlist-card {
  display: inline-block;
  width: 220rpx;
  margin-right: 30rpx;
  vertical-align: top;
}
.playlist-card:last-child {
  margin-right: 0;
}
.playlist-card-hover {
  transform: translateY(-3rpx);
  transition: transform 0.2s;
}

/* 歌单封面黑胶样式 */
.playlist-vinyl {
  position: relative;
  width: 220rpx;
  height: 220rpx;
  margin-bottom: 15rpx;
}
.playlist-img {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  object-fit: cover;
  border: 5rpx solid #2d2d2d;
  z-index: 1;
}
.playlist-vinyl-ring {
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #222, #1a1a1a);
  box-shadow: 0 5rpx 15rpx rgba(0,0,0,0.4);
}
.playlist-vinyl-dot {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background-color: #121212;
  border: 3rpx solid #333;
  z-index: 2;
}

.playlist-name {
  display: block;
  font-size: 28rpx;
  color: #fff;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  margin-bottom: 8rpx;
}
.playlist-hot {
  display: block;
  font-size: 22rpx;
  color: #999;
}

/* 最近播放区（横向滚动） */
.recent-section {
  margin-bottom: 40rpx;
}
.recent-scroll {
  white-space: nowrap;
  padding-bottom: 10rpx;
  overflow-y: hidden;
}
.recent-list {
  display: inline-flex;
  gap: 20rpx;
}
.recent-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  width: 160rpx;
  transition: transform 0.2s;
}
.recent-item:active {
  transform: scale(0.95);
}
.recent-vinyl {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 12rpx;
}
.recent-img {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 130rpx;
  height: 130rpx;
  border-radius: 50%;
  object-fit: cover;
  border: 4rpx solid #2d2d2d;
  z-index: 1;
}
.recent-vinyl-ring {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #222, #1a1a1a);
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.4);
}
.recent-vinyl-dot {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background-color: #121212;
  border: 3rpx solid #333;
  z-index: 2;
}
.recent-title {
  display: block;
  font-size: 24rpx;
  color: #fff;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  width: 100%;
  text-align: center;
  margin-bottom: 4rpx;
}
.recent-artist {
  display: block;
  font-size: 20rpx;
  color: #888;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  width: 100%;
  text-align: center;
}

/* 推荐歌曲区（仅上下滑动） */
.song-section {
  margin-top: 20rpx;
}
.song-scroll {
  height: calc(100vh - 1100rpx); /* 固定高度：屏幕高度 - 上方内容高度 */
  overflow-x: hidden; /* 禁止横向滚动 */
}

.song-list {
  background-color: #1a1a1a;
  border-radius: 16rpx;
  overflow: hidden;
}
.song-item {
  display: flex;
  align-items: center;
  height: 120rpx;
  padding: 0 25rpx;
  border-bottom: 1rpx solid rgba(255,255,255,0.05);
}
.song-item:last-child {
  border-bottom: none;
}
.song-item-hover {
  background-color: rgba(158, 42, 43, 0.08);
}

.song-index {
  width: 50rpx;
  font-size: 26rpx;
  color: #888;
  text-align: center;
}

/* 歌曲封面黑胶样式 */
.song-vinyl {
  position: relative;
  width: 80rpx;
  height: 80rpx;
  margin-right: 20rpx;
}
.song-img {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  object-fit: cover;
  border: 3rpx solid #333;
  z-index: 1;
}
.song-vinyl-ring {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #222, #1a1a1a);
  box-shadow: 0 3rpx 8rpx rgba(0,0,0,0.3);
}

.song-info {
  flex: 1;
  min-width: 0;
}
.song-title {
  display: block;
  font-size: 28rpx;
  color: #fff;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  line-height: 1.2;
}
.song-artist {
  display: block;
  font-size: 22rpx;
  color: #888;
  margin-top: 5rpx;
}

/* 播放按钮 */
.song-play {
  width: 50rpx;
  height: 50rpx;
  background: none;
  border: none;
  padding: 0;
  margin: 0 20rpx 0 0;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 10;
}
.song-play::after {
  border: none;
}
.play-icon {
  width: 30rpx;
  height: 30rpx;
  tint-color: #ddd;
  transition: tint-color 0.2s;
}
.song-play-hover .play-icon {
  tint-color: #9e2a2b;
}

.song-more {
  width: 30rpx;
  height: 30rpx;
  tint-color: #888;
  position: relative;
  z-index: 10;
  transition: tint-color 0.2s;
}
.song-more:active {
  tint-color: #9e2a2b;
}

/* 弹窗样式 */
popup {
  --bg-color: #1a1a1a;
  --text-color: #fff;
  --title-color: #9e2a2b;
  --border-color: rgba(255,255,255,0.1);
  --btn-color: #9e2a2b;
}