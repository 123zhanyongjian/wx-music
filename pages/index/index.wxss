.index-bg {
  min-height: 100vh;
  background: linear-gradient(135deg, #1ed760 0%, #25c96a 60%, #187a3c 100%);
}
.header-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
  padding: 40rpx 0 20rpx 40rpx;
  letter-spacing: 2rpx;
}
.tab-bar {
  display: flex;
  flex-direction: row;
  justify-content: space-around;
  align-items: center;
  background: rgba(255,255,255,0.08);
  border-radius: 40rpx;
  margin: 0 30rpx 30rpx 30rpx;
  padding: 10rpx 0;
}
.tab-item {
  font-size: 28rpx;
  color: #fff;
  padding: 12rpx 36rpx;
  border-radius: 32rpx;
  transition: background 0.2s, color 0.2s;
}
.tab-item.active {
  background: #1ed760;
  color: #141e30;
  font-weight: bold;
}

.containers {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  grid-gap: 24rpx;
  padding: 10rpx 16rpx 40rpx 16rpx;
  background: none;
}

.musicItem {
  width: 92%;
  box-shadow: 0 6rpx 24rpx rgba(0,0,0,0.18);
  overflow: hidden;
  text-align: left;
  margin: 18rpx auto;
  padding: 0 0 20rpx 0;
  background: rgba(20, 30, 48, 0.85);
  border-radius: 24rpx;
  transition: transform 0.15s, box-shadow 0.15s;
}
.musicItem:active {
  transform: scale(0.97);
  box-shadow: 0 2rpx 8rpx rgba(30,215,96,0.18);
}
.cover {
  width: 90%;
  aspect-ratio: 1/1;
  margin: 24rpx auto 0 auto;
  border-radius: 18rpx;
  background-position: center center;
  background-size: cover;
  box-shadow: 0 4rpx 16rpx rgba(30,215,96,0.12);
}
.musicMeta {
  padding: 0 24rpx;
}
.title {
  margin-top: 18rpx;
  font-size: 28rpx;
  color: #fff;
  font-weight: bold;
  letter-spacing: 1rpx;
}
.description {
  margin-top: 10rpx;
  margin-bottom: 10rpx;
  font-size: 20rpx;
  color: #b2ffb2;
  display: flex;
  justify-content: space-between;
}
.hot{
  width: 32rpx;
  height: 32rpx;
  vertical-align:text-bottom;
}

.netease-bg {
  min-height: 100vh;
  background: var(--bg-color);
  padding-bottom: 40rpx;
}
.netease-header {
  font-size: 44rpx;
  font-weight: bold;
  color: var(--main-color);
  padding: 48rpx 0 24rpx 40rpx;
  letter-spacing: 2rpx;
}
.netease-grid {
  display: flex;
  flex-direction: row;
  justify-content: space-around;
  align-items: center;
  margin: 0 0 32rpx 0;
}
.netease-grid-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: var(--white);
  border-radius: 24rpx;
  box-shadow: var(--card-shadow);
  width: 160rpx;
  height: 160rpx;
  justify-content: center;
  margin: 0 8rpx;
  transition: var(--transition);
  border: 2rpx solid var(--main-color);
}
.netease-grid-item:active {
  box-shadow: 0 8rpx 32rpx rgba(194,12,12,0.12);
  background: var(--main-color-light);
  color: #fff;
}
.netease-grid-icon {
  width: 64rpx;
  height: 64rpx;
  margin-bottom: 12rpx;
}
.netease-grid-text {
  font-size: 26rpx;
  color: var(--main-color);
  font-weight: 500;
}
.netease-section-title {
  font-size: 32rpx;
  color: var(--secondary-color);
  font-weight: bold;
  margin: 32rpx 0 16rpx 32rpx;
}
.netease-recommend-scroll {
  white-space: nowrap;
  padding-left: 24rpx;
  padding-right: 24rpx;
  padding-bottom: 8rpx;
  box-sizing: border-box;
}
.netease-recommend-card {
  display: inline-block;
  width: 220rpx;
  background: var(--white);
  border-radius: 18rpx;
  margin-right: 24rpx;
  box-shadow: var(--card-shadow);
  overflow: hidden;
  vertical-align: top;
  border: 2rpx solid #fff;
  transition: var(--transition);
}
.netease-recommend-card:last-child {
  margin-right: 0;
}
.netease-recommend-card:active {
  border: 2rpx solid var(--main-color);
  box-shadow: 0 8rpx 32rpx rgba(194,12,12,0.12);
}
.netease-recommend-img {
  width: 220rpx;
  height: 220rpx;
  border-radius: 18rpx 18rpx 0 0;
  background: #eee;
  display: block;
}
.netease-recommend-name {
  font-size: 24rpx;
  color: var(--secondary-color);
  font-weight: 500;
  margin: 12rpx 12rpx 0 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.netease-recommend-info {
  font-size: 20rpx;
  color: #888;
  margin: 8rpx 12rpx 12rpx 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.netease-song-list {
  margin: 0 24rpx 40rpx 24rpx;
}
.netease-song-item {
  display: flex;
  align-items: center;
  background: var(--white);
  border-radius: 16rpx;
  box-shadow: var(--card-shadow);
  margin-bottom: 18rpx;
  padding: 0 20rpx;
  transition: var(--transition);
  position: relative;
  overflow: hidden;
  width: 100%;
  box-sizing: border-box;
  min-height: 100rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.netease-song-item:active {
  box-shadow: 0 8rpx 32rpx rgba(194,12,12,0.18);
  background: #fff5f5;
}
.netease-song-item-alt {
  background: #f7f7f7;
}
.netease-song-cover {
  width: 72rpx;
  height: 72rpx;
  border-radius: 12rpx;
  margin-right: 18rpx;
  background: #eee;
  position: relative;
  overflow: hidden;
  flex-shrink: 0;
}
.netease-song-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
  align-items: flex-start;
}
.netease-song-title {
  font-size: 30rpx;
  color: var(--main-color);
  font-weight: 700;
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.netease-song-artist {
  font-size: 22rpx;
  color: #888;
  margin-top: 2rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.netease-song-play {
  background: none;
  border: none;
  box-shadow: none;
  width: 60rpx;
  height: 60rpx;
  padding: 0;
  margin-left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  position: absolute;
  right: 70rpx;
  top: 50%;
  bottom: auto;
  margin-top: 0;
  transform: translateY(-50%);
  z-index: 2;
  transition: background 0.15s;
}
.netease-song-play:active {
  background: rgba(194,12,12,0.08);
}
.netease-song-play-icon {
  width: 40rpx;
  height: 40rpx;
  display: block;
}
.more {
  position: absolute;
  right: 10rpx;
  top: 50%;
  bottom: auto;
  width: 60rpx;
  height: 60rpx;
  border-left: 1px solid #eee;
  margin-top: 0;
  transform: translateY(-50%);
}
.footer, .bottom-bar, .index-bottom, .index-footer {
  bottom: 120rpx !important;
}
.tabbar-safe-area, .page-root, .main-container, body {
  padding-bottom: 120rpx;
  box-sizing: border-box;
}