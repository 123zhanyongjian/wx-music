/* 黑胶风格基础变量 */
.black-vinyl-page {
  --vinyl-black: #121212; /* 主背景 */
  --vinyl-darker: #1a1a1a; /* 卡片背景 */
  --accent-color: #9e2a2b; /* 酒红色强调色 */
  --text-primary: #fff; /* 主文本 */
  --text-secondary: #888; /* 次要文本 */
  --border-color: rgba(255,255,255,0.05); /* 深色边框 */
  --status-bar-height: constant(safe-area-inset-top);
  --status-bar-height: env(safe-area-inset-top);
  --bottom-safe: calc(50px + env(safe-area-inset-bottom));
  background-color: var(--vinyl-black); /* 整体深色背景 */
  min-height: 100vh;
  padding-bottom: var(--bottom-safe); /* 底部安全区 */
}

/* 顶部背景（黑胶模糊效果） */
.imgs {
  position: absolute;
  z-index: 0;
  width: 100%;
  height: calc(525rpx + var(--status-bar-height)); /* 高度+状态栏 */
  background-size: cover;
  background-position: center;
  filter: blur(40px); /* 黑胶标志性模糊 */
  opacity: 0.6; /* 降低亮度 */
}

/* 半透明遮罩（增强文字可读性） */
.ng {
  position: absolute;
  height: calc(525rpx + var(--status-bar-height)); /* 高度+状态栏 */
  width: 100%;
  background: linear-gradient(to bottom, rgba(0,0,0,0.2), rgba(0,0,0,0.9)); /* 渐变遮罩 */
  z-index: 1;
}

/* 左侧专辑封面（黑胶风格） */
.headLog {
  position: absolute;
  z-index: 10;
  left: 50rpx;
  top: calc(50rpx + var(--status-bar-height)); /* 适配状态栏 */
}
.headLog>image {
  height: 260rpx;
  width: 260rpx; 
  border-radius: 15px;
  border: 4rpx solid rgba(255,255,255,0.1); /* 黑胶边框 */
  box-shadow: 0 8rpx 20rpx rgba(0,0,0,0.5); /* 立体阴影 */
}

/* 右侧专辑信息（黑胶配色） */
.singer {
  position: absolute;
  z-index: 10;
  left: 330rpx;
  top: calc(50rpx + var(--status-bar-height)); /* 适配状态栏 */
  color: rgba(255,255,255,0.8);
  max-width: 450rpx; /* 限制宽度，避免溢出 */
}
.singer>view:first-child {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-primary); /* 白色专辑名 */
  margin-bottom: 15rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap; /* 标题过长显示省略号 */
}
.release-date {
  font-size: 24rpx;
  color: var(--text-secondary); /* 灰色发行时间 */
  margin-bottom: 10rpx;
}
.text {
  padding: 10rpx 0;
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.4;
}

/* 播放全部栏（黑胶风格） */
.play-all-bar {
  background-color: var(--vinyl-darker); /* 深色卡片背景 */
  border-radius: 16px;
  padding: 20rpx 50rpx;
  margin-bottom: 15rpx;
  border-bottom: 1rpx solid var(--border-color);
}
.play-icon {
  width: 60rpx;
  height: 60rpx;
  tint-color: var(--accent-color); /* 酒红色播放图标 */
  vertical-align: middle;
}
.play-text {
  color: var(--text-primary); /* 白色文字 */
  font-size: 30rpx;
  margin-left: 10rpx;
  vertical-align: middle;
}

/* 滚动区样式（黑胶风格） */
.scroll-view {
  position: absolute;
  z-index: 2;
  width: 100%;
  top: calc(490rpx + var(--status-bar-height)); /* 适配状态栏 */
  background-color: var(--vinyl-black);
  padding-bottom: var(--bottom-safe); /* 底部安全区（避开TabBar） */
}
.ul {
  width: 100%;
  border-radius: 16px;
  padding: 0 24rpx;
  box-sizing: border-box;
}

/* 歌曲列表项（黑胶风格适配） */
.li {
  background-color: var(--vinyl-darker);
  border-bottom: 1rpx solid var(--border-color);
  color: var(--text-primary);
}
.li:nth-of-type(2n-1) {
  background-color: #1a1a1a; /* 取消浅色交替，统一深色 */
}

/* 歌曲列表组件样式（黑胶适配） */
.netease-song-item {
  background-color: var(--vinyl-darker);
  border-bottom: 1rpx solid var(--border-color);
}
.netease-song-title {
  color: var(--text-primary);
  max-width: calc(100% - 180rpx); /* 避免遮挡功能区 */
}
.netease-song-artist {
  color: var(--text-secondary);
}
.netease-song-play-icon {
  tint-color: var(--accent-color); /* 播放按钮用主题色 */
}

/* 滚动容器高度 */
.popusShowopen {
  height: calc(100vh - 525rpx - var(--status-bar-height) - var(--bottom-safe));
  overflow: hidden;
  z-index: 1 !important; /* 弹窗打开时降低层级，确保在弹窗下方 */
  position: relative; /* 确保 z-index 生效 */
}