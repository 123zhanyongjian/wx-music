<view class="player-container tab-content">
  <!-- 顶部返回栏 -->
  <view class="top-bar">
    <image src="/image/svg/back.svg" class="back-btn" bindtap="onBack" mode="widthFix"></image>
    <text class="title">{{showLyric ? '歌词' : '正在播放'}}</text>
    <image src="/image/svg/more.svg" class="more-btn" mode="widthFix"></image>
  </view>

  <!-- 切换按钮（歌词/播放视图） -->
  <view class="toggle-btn" bindtap="toggleLyric">
    <text class="toggle-text">{{lrc[toLineNum].lrc || ''}}</text>
  </view>

  <!-- 播放器视图 -->
  <view class="player-view {{showLyric ? 'fade-out' : 'fade-in'}}" 
        style="display: {{showLyric ? 'none' : 'flex'}}">
    <!-- 专辑封面区域 -->
    <view class="cover-wrapper">
      <view class="vinyl">
        <image 
          class="cover {{isPlaying ? 'rotate' : ''}}" 
          src="{{img}}"
          mode="widthFix"
        ></image>
        <view class="cover-center"></view>
      </view>
    </view>
    
    <!-- 歌曲信息 -->
    <view class="song-info">
      <view class="song-name">{{title}}</view>
      <view class="singer-name">{{author}}</view>
    </view>

    <!-- 进度条 -->
    <view class="progress-area">
      <text class="time current">{{conduct}}</text>
      <view class="custom-slider" 
            bindtouchstart="onSliderTouchStart" 
            bindtouchmove="onSliderTouchMove" 
            bindtouchend="onSliderTouchEnd">
        <view class="progress-bar">
          <view class="played-progress" style="width: {{sliderProgress}}%"></view>
          <view class="progress-dot" style="left: {{sliderProgress}}%"></view>
        </view>
      </view>
      <text class="time total">{{Duration}}</text>
    </view>

    <!-- 控制按钮 -->
    <view class="control-btns">
      <image src="/image/svg/prev.svg" class="btn prev" bindtap="onPrev" mode="widthFix"></image>
      <image 
        src="{{isPlaying ? '/image/svg/pause.svg' : '/image/svg/play.svg'}}" 
        class="btn play" 
        bindtap="onPlayPause"
        mode="widthFix"
      ></image>
      <image src="/image/svg/next.svg" class="btn next" bindtap="onNext" mode="widthFix"></image>
    </view>
  </view>

  <!-- 歌词视图 -->
  <view class="lyric-view {{showLyric ? 'fade-in' : 'fade-out'}}"
        style="display: {{showLyric ? 'flex' : 'none'}}">
    <!-- 歌曲信息 -->
    <view class="song-info">
      <text class="song-name">{{song.title}}</text>
      <text class="singer-name">{{song.author}}</text>
    </view>

    <!-- 歌词滚动区 -->
    <scroll-view class='scroll-view' 
                 scroll-into-view-alignment="center"  
                 scroll-y 
                 scroll-with-animation 
                 scroll-into-view="line{{toLineNum - 2}}">
      <view 
        id="line{{index}}"
        wx:for="{{lrc}}" 
        wx:key="index"
        class="lyric-item {{toLineNum === index ? 'active' : ''}}"
      >
        {{item.lrc}}
      </view>
    </scroll-view>

    <!-- 进度条 -->
    <view class="progress-area">
      <text class="time current">{{conduct}}</text>
      <view class="custom-slider" 
            bindtouchstart="onSliderTouchStart" 
            bindtouchmove="onSliderTouchMove" 
            bindtouchend="onSliderTouchEnd">
        <view class="progress-bar">
          <view class="played-progress" style="width: {{sliderProgress}}%"></view>
          <view class="progress-dot" style="left: {{sliderProgress}}%"></view>
        </view>
      </view>
      <text class="time total">{{Duration}}</text>
    </view>
  </view>

  <!-- 底部控制 -->
  <view class="bottom-controls">
    <image src="/image/svg/loop.svg" class="bottom-btn {{loopMode === 1 ? 'active' : ''}}" bindtap="onLoop" mode="widthFix"></image>
    <image src="/image/svg/lyric.svg" class="bottom-btn" bindtap="toggleLyric" mode="widthFix"></image>
    <!-- 音质切换按钮 -->
    <view class="quality-btn" bindtap="toggleQualityPopup">
      <image src="/image/svg/quality.svg" class="quality-icon" mode="widthFix"></image>
      <!-- <text class="quality-text">{{currentQuality.text}}</text> -->
    </view>
    <image src="/image/svg/list.svg" class="bottom-btn" bindtap="showPlayList" mode="widthFix"></image>
  </view>
</view>

<!-- 播放列表容器 -->
<view class="playlist-container {{showPlayList ? 'show' : ''}}">
  <view class="playlist-mask" bindtap="hidePlayList"></view>
  <view class="playlist-content">
    <view class="playlist-header">
      <text class="playlist-title">播放列表 ({{songList.length}})</text>
      <text class="close-btn" bindtap="closeList">清空</text>
    </view>
    <scroll-view class="playlist-scroll" scroll-y>
      <view class="playlist-list">
        <view 
          wx:for="{{songList}}" 
          wx:key="index"
          class="playlist-item {{ins === index ? 'current' : ''}}"
          bindtap="switchSong" 
          data-index="{{index}}"
          bindlongpress="deleteSong"
          data-songindex="{{index}}"
        >
          <view class="item-info">
            <text class="item-name">{{item.title}}</text>
            <text class="item-singer">{{item.author}}</text>
          </view>
          <image 
            src="/image/svg/play.svg" 
            class="item-playicon" 
            hidden="{{ins !== index}}"
            mode="widthFix"
          ></image>
        </view>
      </view>
    </scroll-view>
  </view>
</view>

<!-- 音质选择弹窗（4个选项） -->
<view class="quality-popup {{showQualityPopup ? 'show' : ''}}">
  <view class="quality-popup-mask" bindtap="toggleQualityPopup"></view>
  <view class="quality-popup-content">
    <view class="quality-title">选择音源质量</view>
    <view 
      class="quality-item" 
      wx:for="{{qualityList}}" 
      wx:key="text"
      bindtap="chooseQuality"
      data-quality="{{item}}"
    >
      <text>{{item.text}}</text>
      <image 
        src="/image/svg/check.svg" 
        class="quality-check" 
        hidden="{{currentQuality.text !== item.text}}"
        mode="widthFix"
      ></image>
    </view>
  </view>
</view>
