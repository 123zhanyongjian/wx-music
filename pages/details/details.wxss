/* 黑胶风格基础变量（统一风格） */
.black-vinyl-page {
  --vinyl-black: #121212; /* 主背景 */
  --vinyl-darker: #1a1a1a; /* 卡片背景 */
  --accent-color: #9e2a2b; /* 酒红色强调色 */
  --text-primary: #fff; /* 主文本 */
  --text-secondary: #888; /* 次要文本 */
  --status-bar-height: constant(safe-area-inset-top);
  --status-bar-height: env(safe-area-inset-top);
  --bottom-safe: calc(50px + env(safe-area-inset-bottom));
}

/* 整体容器 */
.mains {
  background-color: var(--vinyl-black);
  min-height: 100vh;
  padding-top: var(--status-bar-height); /* 顶部安全区 */
  padding-bottom: var(--bottom-safe); /* 底部安全区 */
  box-sizing: border-box;
}

/* 顶部背景（黑胶模糊效果） */
.imgs {
  position: absolute;
  z-index: 0;
  width: 100%;
  height: calc(525rpx + var(--status-bar-height)); /* 高度+状态栏 */
  background-size: cover;
  background-position: center;
  filter: blur(40px); /* 黑胶标志性模糊 */
  opacity: 0.6; /* 降低亮度，避免刺眼 */
}

/* 右上角更多按钮（适配状态栏） */
.mores {
  position: absolute;
  right: 15rpx;
  z-index: 10;
  top: calc(15px + var(--status-bar-height)); /* 下移状态栏高度 */
  width: 60rpx;
  height: 60rpx;
  tint-color: #fff; /* 白色图标适配深色 */
}

/* 半透明遮罩（增强文字可读性） */
.ng {
  position: absolute;
  height: calc(525rpx + var(--status-bar-height)); /* 高度+状态栏 */
  width: 100%;
  background: linear-gradient(to bottom, rgba(0,0,0,0.1), rgba(0,0,0,0.8)); /* 渐变遮罩 */
  z-index: 1;
}

/* 左侧封面（黑胶风格） */
.headLog {
  position: absolute;
  z-index: 10;
  left: 50rpx;
  top: calc(80rpx + var(--status-bar-height)); /* 下移状态栏高度 */
}
.headLog>image {
  height: 320rpx;
  width: 320rpx; 
  border-radius: 20rpx;
  border: 4rpx solid rgba(255,255,255,0.1); /* 黑胶边框 */
  box-shadow: 0 10rpx 30rpx rgba(0,0,0,0.5); /* 立体阴影 */
}

/* 右侧信息区（黑胶配色） */
.singer {
  position: absolute;
  z-index: 10;
  left: 400rpx;
  top: calc(80rpx + var(--status-bar-height)); /* 下移状态栏高度 */
  color: rgba(255,255,255,0.8);
  max-width: 400rpx; /* 限制宽度，避免溢出 */
}
.singer>view:first-child {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-primary); /* 白色主标题 */
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap; /* 标题过长显示省略号 */
}
.text {
  padding: 10rpx 0;
  font-size: 24rpx;
  color: var(--text-secondary); /* 灰色次要文本 */
  line-height: 1.4;
}

/* 播放全部栏（黑胶风格） */
.play-all-bar {
  background-color: var(--vinyl-darker);
  border-top-left-radius: 16px;
  border-top-right-radius: 16px;
  padding: 20rpx 30rpx;
  border-bottom: 1rpx solid rgba(255,255,255,0.05);
}
.play-icon {
  width: 60rpx;
  height: 60rpx;
  tint-color: var(--accent-color); /* 酒红色图标 */
  vertical-align: middle;
}
.play-text {
  color: var(--text-primary);
  font-size: 30rpx;
  margin-left: 10rpx;
  vertical-align: middle;
}
.loop-container {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.loop {
  width: 40rpx;
  height: 40rpx;
  tint-color: var(--text-secondary); /* 灰色循环图标 */
}

/* 滚动区样式 */
.scroll-view {
  position: absolute;
  z-index: 2;
  width: 100%;
  top: calc(490rpx + var(--status-bar-height)); /* 下移状态栏高度 */
  background-color: var(--vinyl-black);
  padding-bottom: var(--bottom-safe); /* 底部留空，避免被TabBar遮挡 */
}
.ul {
  width: 100%;
  border-radius: 16px;
  padding: 0 24rpx;
  box-sizing: border-box;
}

/* 歌曲列表项（黑胶风格适配） */
.netease-song-item {
  background-color: var(--vinyl-darker);
  border-bottom: 1rpx solid rgba(255,255,255,0.05);
  margin-bottom: 12rpx;
}
.netease-song-title {
  color: var(--text-primary); /* 白色歌曲名 */
  max-width: calc(100% - 180rpx); /* 限制宽度，避免遮挡功能区 */
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.netease-song-artist {
  color: var(--text-secondary); /* 灰色歌手名 */
}
.netease-song-play-icon {
  tint-color: var(--accent-color); /* 酒红色播放按钮 */
}
.netease-song-item:active {
  background-color: rgba(158,42,43,0.1); /* 点击反馈（酒红色透明） */
}

/* 功能按钮区（确保不被遮挡） */
.more {
  border-left: 1rpx solid rgba(255,255,255,0.05); /* 深色分隔线 */
}