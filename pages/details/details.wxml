<wxs src="../singerdetails/singerdetails.wxs" module="module"></wxs>
<view class="mains black-vinyl-page"> <!-- 新增黑胶风格容器类 -->
  <view class=''>
    <!-- 顶部背景图 -->
    <image class='imgs' style="background-image:url({{src}})"></image>
    
    <!-- 右上角更多按钮 -->
    <image wx:if="{{id==='my'}}" class="mores" src="../../image/morew.png" bind:tap="synchronous"></image>
     
    <!-- 歌手/专辑信息区 -->
    <view class='ng'>
      <view class="headLog">
        <image src="{{src}}" />
      </view>
      <view class="singer">
        <view hover-class="none" hover-stop-propagation="false">{{title}}</view>
        <view wx:if="{{id==='kw'}}" class="text" catchtap="openSingerInfo">日期：{{time}}</view>
        <view wx:if="{{id!=='kw'&&id!=='my'}}" class="text" catchtap="openSingerInfo">{{module.substrins(singerInfo,110)}}</view>
        <view wx:if="{{id!=='kw'&&id!=='my'}}" class="text">{{tag}}</view>
      </view>
    </view>
  </view>

  <!-- 歌曲列表滚动区 -->
  <scroll-view class="{{popusShow?'popusShowopen':''}} ul scroll-view" scroll-y="{{popusShow?false:true}}">
    <!-- 播放全部栏 -->
    <view class="li play-all-bar"> <!-- 新增播放栏风格类 -->
      <view class="logo listtop flex just_betw">
        <view bindtap='whole'>
          <image src="../../image/plays.png" class="play-icon" />
          <text class="play-text">播放全部({{list.length}})</text>
        </view>
        <view class="loop-container">
          <image class='loop' src="{{loop}}" bindtap="changloop"></image>
        </view>
      </view>
    </view>
     
    <!-- 歌曲列表组件 -->
    <song-list list="{{list}}" bind:play="pay" bind:more="more" />
    
    <!-- 弹窗组件 -->
    <popup song="{{song}}" bind:close="popusShowChange" show="{{popusShow}}" wx:if="{{popusShow}}" header="添加到歌单"></popup>
  </scroll-view>
</view>