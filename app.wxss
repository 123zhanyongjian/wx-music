/* 网易云风格全局变量 */
:root {
  --main-color: #C20C0C;
  --main-color-light: #e94040;
  --secondary-color: #333;
  --text-color: #222;
  --text-color-light: #666;
  --bg-color: #f5f5f5;
  --white: #fff;
  --card-radius: 16rpx;
  --card-shadow: 0 4rpx 16rpx rgba(60,80,120,0.08);
  --transition: all 0.2s cubic-bezier(.4,0,.2,1);
}

body, page {
  font-family: 'PingFang SC', 'Microsoft YaHei', Arial, sans-serif;
  background: var(--bg-color);
  color: var(--text-color);
}
.avatar-img {
  /* 其他样式不变 */
  z-index: 2; /* 确保高于外圈的z-index:1 */
}
.avatar-ring {
  /* 其他样式不变 */
  z-index: 1; /* 低于头像 */
}
.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  padding: 120rpx 0 60rpx 0;
  box-sizing: border-box;
  background: var(--bg-color);
}

/* 卡片通用样式 */
.card {
  background: var(--white);
  border-radius: var(--card-radius);
  box-shadow: var(--card-shadow);
  transition: var(--transition);
}

/* 按钮通用样式 */
.btn {
  background: var(--main-color);
  color: #fff;
  border: none;
  border-radius: 32rpx;
  padding: 16rpx 48rpx;
  font-size: 28rpx;
  font-weight: 500;
  transition: var(--transition);
}
.btn:active {
  background: var(--main-color-light);
}

/* 标题通用样式 */
.title {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--text-color);
  margin-bottom: 16rpx;
}

/* 细节优化 */
.flex {
  display: flex;
}
.just_betw {
  justify-content: space-between;
}

/* 兼容原有样式 */
audio {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
}
.mains {
  position: absolute;
  top: 20rpx;
  bottom: 0;left: 0;right: 0;
  background-color: #f1f1f1;
  max-width: 100vw;
}
video {
  width: 100%;
}
.mv {
  text-align: center;
  font-size: 24rpx;
  margin:10rpx auto;
  width: 80rpx;
  height: 30rpx;
  border:1rpx solid var(--main-color);
  color: var(--main-color);
  border-radius: 16rpx;
  background: #fff;
}


/* 用于所有 TabBar 页面的内容容器类 */
.tab-content {
  /* 基础内边距：适配不支持 safe-area-inset 的设备 */
  padding-bottom: 50px;
  padding-top: 50px !important;
  /* 高级内边距：适配支持 safe-area-inset 的设备 */
  padding-bottom: calc(10px + constant(safe-area-inset-bottom)) !important; /* 兼容 iOS < 11.2 */
  padding-bottom: calc(10px + env(safe-area-inset-bottom)) !important;     /* 兼容 iOS >= 11.2 */
  
  /* 顶部安全区（可选，根据页面需求） */
  padding-top: constant(safe-area-inset-top) !important; /* 兼容 iOS < 11.2 */
  padding-top: env(safe-area-inset-top) !important;     /* 兼容 iOS >= 11.2 */
}

/* 若页面有固定顶部导航栏，添加这个类 */
.tab-content-with-header {
  padding-top: calc(45px + constant(safe-area-inset-top)) !important; /* 假设导航栏高 45px */
  padding-top: calc(45px + env(safe-area-inset-top)) !important;
}