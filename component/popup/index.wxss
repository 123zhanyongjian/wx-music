/* 遮罩层（始终存在，但隐藏时透明且不响应事件） */
.mains {
  position: fixed;
  z-index: 9999; /* 提高层级，确保在所有内容之上 */
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.7);
  opacity: 0;
  transition: opacity 0.3s ease;
  pointer-events: none; /* 隐藏时不响应点击 */
}

/* 遮罩层显示状态 */
.mains-show {
  opacity: 1;
  pointer-events: auto; /* 显示时响应点击 */
}

/* 弹窗容器（底部滑入/滑出动画） */
.container {
  position: fixed;
  z-index: 10000; /* 提高层级，确保在遮罩层之上 */
  bottom: 0;
  left: 0;
  right: 0;
  height: 60vh;
  background-color: #1a1a1a;
  border-top-left-radius: 24rpx;
  border-top-right-radius: 24rpx;
  box-shadow: 0 -5rpx 20rpx rgba(0, 0, 0, 0.5);
  transform: translateY(100%); /* 默认在屏幕外 */
  transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

/* 弹窗显示状态 */
.container-show {
  transform: translateY(0);
}

/* 头部标题区 */
.popup-header {
  padding: 30rpx 20rpx 15rpx;
  text-align: center;
  position: relative;
}

.popup-header text {
  font-size: 36rpx;
  font-weight: 600;
  color: #fff;
}

.header-line {
  width: 60rpx;
  height: 4rpx;
  background-color: #9e2a2b;
  margin: 15rpx auto 0;
  border-radius: 2rpx;
}

/* 操作按钮 */
.popup-btns {
  position: absolute;
  top: 25rpx;
  left: 0;
  right: 0;
  display: flex;
  justify-content: space-between;
  padding: 0 30rpx;
}

.btn {
  font-size: 32rpx;
  padding: 8rpx 15rpx;
  border-radius: 15rpx;
  transition: all 0.2s;
}

.cancel-btn {
  color: #aaa;
  background-color: rgba(255, 255, 255, 0.08);
}

.cancel-btn:active {
  background-color: rgba(255, 255, 255, 0.15);
}

.confirm-btn {
  color: #fff;
  background-color: #9e2a2b;
}

.confirm-btn:active {
  background-color: #8a2425;
  transform: scale(0.95);
}

/* 内容区 */
.popup-wrapper {
  padding: 20rpx 30rpx;
}

.popup-content {
  height: calc(100% - 120rpx);
}

.current-song {
  padding: 10rpx 0 25rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
  margin-bottom: 20rpx;
}

.song-title {
  font-size: 30rpx;
  color: #fff;
  line-height: 1.3;
}

.song-artist {
  font-size: 24rpx;
  color: #999;
  margin-left: 10rpx;
}

.ul {
  height: calc(60vh - 220rpx);
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}

.playlist-container {
  padding: 10rpx 0;
}

.playlist-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 90rpx;
  padding: 0 10rpx;
  border-radius: 12rpx;
  margin-bottom: 8rpx;
  transition: background-color 0.2s;
}

.playlist-item:active {
  background-color: rgba(158, 42, 43, 0.1);
}

.item-name {
  font-size: 30rpx;
  color: #ddd;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.playlist-item-selected {
  background-color: rgba(158, 42, 43, 0.15);
}

.playlist-item-selected .item-name {
  color: #9e2a2b;
  font-weight: 500;
}

.selected-icon {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background-color: #121212;
  border: 2rpx solid #9e2a2b;
  position: relative;
}

.icon-dot {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background-color: #9e2a2b;
}

.load-more {
  font-size: 26rpx;
  color: #888;
  text-align: center;
  padding: 20rpx 0;
}

.new-btn {
  color: #9e2a2b;
  margin: 0 5rpx;
  font-weight: 500;
}

.empty-state {
  text-align: center;
  padding-top: 80rpx;
}

.empty-img {
  width: 120rpx;
  height: 120rpx;
  tint-color: #555;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #888;
}

.ul::-webkit-scrollbar {
  width: 6rpx;
}

.ul::-webkit-scrollbar-thumb {
  background-color: rgba(255, 255, 255, 0.2);
  border-radius: 3rpx;
}

.ul::-webkit-scrollbar-track {
  background-color: transparent;
}