<wxs src="../../pages/singerdetails/singerdetails.wxs" module="module"></wxs>

<!-- 遮罩层（始终存在，用hidden控制可见性） -->
<view 
  class="mains {{show ? 'mains-show' : 'mains-hide'}}" 
  bindtap="cancel" 
  
>
  <!-- 弹窗容器 -->
  <view class="container {{show ? 'container-show' : 'container-hide'}}">
    <!-- 头部标题区 -->
    <view class="popup-header">
      <text>{{header}}</text>
      <view class="header-line"></view>
    </view>

    <!-- 操作按钮 -->
    <view class="popup-btns">
      <view bindtap="cancel" class="btn cancel-btn">取消</view>
      <view bindtap="confirm" class="btn confirm-btn">确认</view>
    </view>

    <!-- 内容区 -->
    <view class="popup-wrapper">
      <view class="popup-content">
        <view class="popup-body">
          <!-- 新增歌单组件 -->
          <addSongList bind:close="close" bind:newSongList="newSongList" wx:if="{{addSongListFlag}}"/>  

          <!-- 当前歌曲信息 -->
          <view class="current-song">
            <text class="song-title">{{song.title}}</text>
            <text class="song-artist">— {{module.substrins(song.singer,10)||module.substrins(song.author,10)}}</text>
          </view>

          <!-- 歌单列表滚动区 -->
          <scroll-view scroll-y="true" class="ul">
            <!-- 歌单列表 -->
            <view wx:if="{{playlist.length}}" class="playlist-container">
              <view 
                class="playlist-item {{changeId === item.id ? 'playlist-item-selected' : ''}}"
                data-id="{{item.id}}" 
                catchtap="clickList" 
                wx:for="{{playlist}}" 
                wx:key="item.id"
              >
                <text class="item-name">{{item.name}}</text>
                <view wx:if="{{changeId === item.id}}" class="selected-icon">
                  <view class="icon-dot"></view>
                </view>
              </view>

              <!-- 加载更多提示 -->
              <view class="load-more">
                {{playlist.length===count?'没有更多了':'加载更多'}}
                <text bindtap="newListBtn" class="new-btn" wx:if="{{playlist.length===count}}">新建</text>
                <text wx:if="{{playlist.length===count}}">一个？</text>
              </view>
            </view>

            <!-- 空状态 -->
            <view wx:if="{{playlist.length===0}}" class="empty-state">
              <image src="../../image/nodata.svg" class="empty-img" />
              <view class="empty-text">
                歌单列表为空，去
                <text bindtap="newListBtn" class="new-btn">新建</text>
                一个？
              </view>
            </view>
          </scroll-view>
        </view>
      </view>
    </view>
  </view>
</view>