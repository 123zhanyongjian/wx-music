<view class="modal-container {{show ? 'show' : ''}}" wx:if="{{show}}" bindtap="onMaskTap">
  <view class="modal-content" catchtap="stopPropagation">
    <view class="modal-header" wx:if="{{title}}">
      <text class="modal-title">{{title}}</text>
    </view>
    <view class="modal-body" wx:if="{{content}}">
      <text class="modal-text">{{content}}</text>
    </view>
    <view class="modal-footer">
      <button class="modal-button cancel" wx:if="{{showCancel}}" bindtap="onCancel">
        {{cancelText}}
      </button>
      <button class="modal-button confirm" style="color: {{confirmColor}}" bindtap="onConfirm">
        {{confirmText}}
      </button>
    </view>
  </view>
</view>

