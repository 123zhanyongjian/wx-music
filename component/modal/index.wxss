.modal-container {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10000;
  background-color: rgba(0, 0, 0, 0.5);
  opacity: 0;
  transition: opacity 0.3s;
  pointer-events: none;
}

.modal-container.show {
  opacity: 1;
  pointer-events: auto;
}

.modal-content {
  background-color: #fff;
  border-radius: 16rpx;
  width: 600rpx;
  max-width: 90%;
  overflow: hidden;
  transform: scale(0.9);
  transition: transform 0.3s;
}

.modal-container.show .modal-content {
  transform: scale(1);
}

.modal-header {
  padding: 40rpx 40rpx 20rpx;
  text-align: center;
}

.modal-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.modal-body {
  padding: 20rpx 40rpx;
  text-align: center;
  min-height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-text {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  word-break: break-all;
}

.modal-footer {
  display: flex;
  border-top: 1rpx solid #eee;
}

.modal-button {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 32rpx;
  background-color: transparent;
  border: none;
  border-radius: 0;
  padding: 0;
  margin: 0;
}

.modal-button::after {
  border: none;
}

.modal-button.cancel {
  color: #666;
  border-right: 1rpx solid #eee;
}

.modal-button.confirm {
  font-weight: bold;
}

.modal-button:active {
  background-color: #f5f5f5;
}

