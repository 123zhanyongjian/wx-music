.toast-container {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
  pointer-events: none;
  opacity: 0;
  transition: opacity 0.3s;
}

.toast-container.show {
  opacity: 1;
}

.toast-container.mask {
  background-color: rgba(0, 0, 0, 0);
  pointer-events: auto;
}

.toast-content {
  background-color: rgba(0, 0, 0, 0.8);
  color: #fff;
  padding: 24rpx 40rpx;
  border-radius: 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 200rpx;
  max-width: 600rpx;
  pointer-events: auto;
}

.toast-icon {
  width: 60rpx;
  height: 60rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-success {
  width: 60rpx;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  border-radius: 50%;
  background-color: #52c41a;
  color: #fff;
  font-size: 36rpx;
  font-weight: bold;
}

.icon-error {
  width: 60rpx;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  border-radius: 50%;
  background-color: #ff4d4f;
  color: #fff;
  font-size: 36rpx;
  font-weight: bold;
}

.loading-spinner {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  border-top-color: #fff;
  border-radius: 50%;
  animation: toast-spin 0.8s linear infinite;
}

.toast-message {
  font-size: 28rpx;
  line-height: 1.5;
  text-align: center;
  word-break: break-all;
}

@keyframes toast-spin {
  0% {
    transform: rotate(0deg);
  }
  100% {
    transform: rotate(360deg);
  }
}

