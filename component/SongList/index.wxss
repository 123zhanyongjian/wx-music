.li {
  position: relative;
  min-height: 120rpx;
  border-bottom: 1rpx solid rgba(255,255,255,0.05);
}

.li:nth-of-type(2n-1) {
  background: rgba(255,255,255,0.03);
}

.netease-song-item {
  display: flex;
  align-items: center;
  background: #1a1a1a;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.3);
  margin-bottom: 18rpx;
  padding: 0 20rpx;
  transition: all 0.2s;
  position: relative;
  overflow: hidden;
  width: 100%;
  box-sizing: border-box;
  min-height: 120rpx;
}

.netease-song-item:active {
  box-shadow: 0 8rpx 32rpx rgba(158,42,43,0.2);
  background: rgba(158,42,43,0.08);
}

.netease-song-item-alt {
  background: #1e1e1e;
}

/* 黑胶风格封面 */
.netease-song-vinyl {
  position: relative;
  width: 88rpx;
  height: 88rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.vinyl-img {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  object-fit: cover;
  border: 4rpx solid #2d2d2d;
  z-index: 1;
}

.vinyl-ring {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #222, #1a1a1a);
  box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.4);
}

.vinyl-center {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background-color: #121212;
  border: 3rpx solid #333;
  z-index: 2;
}

.netease-song-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
  align-items: flex-start;
}

.netease-song-title {
  font-size: 30rpx;
  color: #fff;
  width: 80%;
  font-weight: 600;
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.netease-song-artist {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
  width: 80%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.netease-song-play {
  background: none;
  border: none;
  width: 60rpx;
  height: 60rpx;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  position: absolute;
  right: 70rpx;
  top: 50%;
  transform: translateY(-50%);
  z-index: 2;
  transition: all 0.15s;
  border-radius: 50%;
}

.netease-song-play:active {
  background: rgba(158,42,43,0.15);
}

.netease-song-play-icon {
  width: 40rpx;
  height: 40rpx;
  display: block;
  tint-color: #ddd;
}

.netease-song-play:active .netease-song-play-icon {
  tint-color: #9e2a2b;
}

.more {
  position: absolute;
  right: 10rpx;
  top: 50%;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transform: translateY(-50%);
  tint-color: #777;
}