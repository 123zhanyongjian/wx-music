.li{
  position: relative;
  min-height:100rpx;
  border-bottom: 2rpx solid #f9f9f9;
}
.li:nth-of-type(2n-1){
  background:rgb(250,250,250);
}
.netease-song-item {
  display: flex;
  align-items: center;
  background: var(--white);
  border-radius: 16rpx;
  box-shadow: var(--card-shadow);
  margin-bottom: 18rpx;
  padding: 0 20rpx;
  transition: var(--transition);
  position: relative;
  overflow: hidden;
  width: 100%;
  box-sizing: border-box;
  min-height: 100rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.netease-song-item:active {
  box-shadow: 0 8rpx 32rpx rgba(194,12,12,0.18);
  background: #fff5f5;
}
.netease-song-item-alt {
  background: #f7f7f7;
}
.netease-song-cover {
  width: 72rpx;
  height: 72rpx;
  border-radius: 12rpx;
  margin-right: 18rpx;
  background: #eee;
  position: relative;
  overflow: hidden;
  flex-shrink: 0;
}
.netease-song-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
  align-items: flex-start;
}
.netease-song-title {
  font-size: 30rpx;
  color: var(--main-color);
  font-weight: 700;
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.netease-song-artist {
  font-size: 22rpx;
  color: #888;
  margin-top: 2rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.netease-song-play {
  background: none;
  border: none;
  box-shadow: none;
  width: 60rpx;
  height: 60rpx;
  padding: 0;
  margin-left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  position: absolute;
  right: 70rpx;
  top: 50%;
  bottom: auto;
  margin-top: 0;
  transform: translateY(-50%);
  z-index: 2;
  transition: background 0.15s;
}
.netease-song-play:active {
  background: rgba(194,12,12,0.08);
}
.netease-song-play-icon {
  width: 40rpx;
  height: 40rpx;
  display: block;
}
.more {
  position: absolute;
  right: 10rpx;
  top: 50%;
  bottom: auto;
  width: 60rpx;
  height: 60rpx;
  border-left: 1px solid #eee;
  margin-top: 0;
  transform: translateY(-50%);
} 